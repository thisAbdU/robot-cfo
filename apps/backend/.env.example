# PostgreSQL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/robot_cfo?schema=public"

# LI.FI JS SDK (https://docs.li.fi/integrate-li.fi-js-sdk/set-up-the-sdk)
LIFI_INTEGRATOR="robot-cfo"
# Optional: higher rate limits / production keys from LI.FI
LIFI_API_KEY=""

# Snapshot (hub.snapshot.org) — comma-separated Snapshot space ids (e.g. balancer.eth)
SNAPSHOT_SPACE_IDS="balancer.eth"
